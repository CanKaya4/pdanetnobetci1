<Window x:Class="TetherMax.Dashboard" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="../Assets/tethermax.ico" FontFamily="Segoe UI Variable Display">
<Grid x:Name="Shell" Background="{DynamicResource BackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#142136" Padding="20,30"><StackPanel><TextBlock Text="◈ TetherMax" Foreground="#55DCE7" FontSize="23" FontWeight="Bold"/><TextBlock Text="GÜVENLİ USB İNTERNET" Foreground="#A9BAD1" FontSize="10" Margin="0,10,0,30"/><TextBlock Text="1.0.0-rc.3" Foreground="#A9BAD1"/><TextBlock Text="USB → Hücresel" Foreground="#55DCE7" Margin="0,20"/></StackPanel></Border>
<TabControl x:Name="Navigation" TabStripPlacement="Left" Grid.Column="1" Margin="0" Background="Transparent" BorderThickness="0"><TabItem Header="⌂   Genel Bakış"><ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="HomeHost"/></ScrollViewer></TabItem><TabItem Header="↔   Bağlantı"><StackPanel Margin="28"><TextBlock Text="Bağlantı süreci" FontSize="28"/><TextBlock Text="{Binding Status}" FontSize="20" Margin="0,24" TextWrapping="Wrap"/><TextBlock Text="İptal ve yeniden deneme ana ekrandan yönetilir. Yönetici onayı Windows tarafından gösterilir." TextWrapping="Wrap"/></StackPanel></TabItem><TabItem Header="◇   Oyun"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ModesHost" Margin="28"/></ScrollViewer></TabItem><TabItem Header="▣   Cihazlar"><StackPanel x:Name="DevicesHost" Margin="28"/></TabItem><TabItem Header="↗   Analiz"><ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="AnalysisHost" Margin="20"/></ScrollViewer></TabItem><TabItem Header="◉   Hotspot"><ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="SharingHost"/></ScrollViewer></TabItem><TabItem Header="⚙   Ayarlar"><ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="SettingsHost" Margin="28"/></ScrollViewer></TabItem><TabItem Header="≡   Tanılama"><ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="DiagnosticsHost" Margin="28"/></ScrollViewer></TabItem></TabControl></Grid></Window>